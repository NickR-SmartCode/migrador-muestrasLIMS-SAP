@{
    ViewBag.Title = "Cheques";
}

<style>
    table th {
        color: white;
        border-color: #bcecf1;
        background-color: #2d4b67;
    }
</style>

<div class="container-fluid" style="height:93%;">
    <div class="card">
        <div class="card-body">
            <div class="row justify-content-between">
                <div class="col-md-9">
                    <div class="topbar-left col-xs-6">
                        <h3>Cheques - Prueba de Concepto para Aprobaciones</h3>
                    </div>
                    <div class="col-xs-6">
                        <div class="topbar-left col-xs-6">
                            <h4 style="font-size:1.2em;">Total de Registros: <span id="spnTotalRegistros"></span></h4>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="col-xs-6 float-end">
                        <button class="btn btn-primary-custom" onclick="ModalNuevo()"><i class="fa-solid fa-user-plus"></i>  Nuevo</button>
                        @*<button class="btn btn-sm  btn-primary pull-right plu" data-target="modal1" onclick="ModalNuevo()" style="margin-left:10px;">Nuevo</button>*@
                    </div>
                </div>
            </div>
        </div>


    </div>
    <br />
    <div class="card">
        <div class="card-body">

            <table id="table_id" class="table table-modern" style="width:100%;">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Fecha</th>
                        <th>Moneda</th>
                        <th>Monto</th>
                        <th>Estado Aprob.</th>
                        <th>Ver Aprob.</th>
                        <th>Enviar Correo Aprob.</th>
                    </tr>
                </thead>
                <tbody id="tbody_Usuarios"></tbody>
            </table>

        </div>
    </div>

    <div class="modal fade" id="modal-form" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="min-width:70%">
            <div class="modal-content">
                <div class="card">
                    <div class="card-body">

                        <div class="card-title">
                            <h5 id='lblTituloModal'></h5>
                        </div>
                        <div class='col s12 m12 '>
                            <div class=''>
                                <input id='txtId' name="txtId" type='hidden' class="form-control input-sm">
                                <div class='form-horizontal'>
                                    <div class="row">
                                        <div class='col-md-12'>
                                            <label for='txtNombre' class="control-label col-sm-4 left-align">Nombre</label>
                                            <div class="col-sm-12" style="padding-bottom:10px">
                                                <input class="form-control form-control-modern smcImputValidacion" id="txtNombre" name="txtNombre" type='text' tabindex="1" />
                                                <small id="error-txtNombre" class="text-danger d-none smcLabelValidacion"></small>
                                            </div>
                                        </div>

                                    </div>


                                    <div class="row">
                                        <div class='col-md-6'>
                                            <label for='txtFecha' class="control-label col-sm-4 left-align">Fecha</label>
                                            <div class="col-sm-12" style="padding-bottom:10px">
                                                <input id='txtFecha' name="txtFecha" type='date' class="form-control form-control-modern smcImputValidacion" tabindex="2">
                                                <small id="error-txtFecha" class="text-danger d-none smcLabelValidacion"></small>
                                            </div>
                                        </div>
                                        <div class='col-md-6'>
                                            <label for='cboMoneda' class="control-label col-sm-4 left-align">Moneda</label>
                                            <div class="col-sm-12" style="padding-bottom:10px">
                                                <select id='cboMoneda' name="cboMoneda" class="form-select form-control-modern smcImputValidacion" tabindex="3">
                                                    <option value="SOL">SOLES</option>
                                                    <option value="USD">DOLARES</option>
                                                    <option value="EUR">EUROS</option>
                                                </select>
                                                <small id="error-cboMoneda" class="text-danger d-none smcLabelValidacion"></small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">

                                        <div class="col-md-6">
                                            <label for='txtMonto' class="control-label col-sm-12 left-align">Monto</label>
                                            <div class="col-sm-12">
                                                <input id='txtMonto' name="txtMonto" type='number' class="form-control form-control-modern smcImputValidacion" tabindex="4">
                                                <small id="error-txtMonto" class="text-danger d-none smcLabelValidacion"></small>

                                            </div>
                                        </div>

                                    </div>

                                    <br />

                                    <div class="row justify-content-end">
                                        <div class="d-flex flex-row-reverse gap-1">
                                            <button type="button" id="btnGrabar" onclick="Guardar()" class="btn btn-primary pull-right plu">Grabar</button>
                                            <button type="button" id="btnCancelar" class="btn btn-danger pull-right" onclick="CerrarModal();">Cerrar</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modal-aprobaciones" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="min-width:70%">
            <div class="modal-content">
                <div class="card">
                    <div class="card-body">

                        <div class="card-title">
                            <h5 id='lblTituloModal'></h5>
                        </div>
                        <div class='col s12 m12 '>
                            <table id="tabla_aprobaciones" class="table table-modern" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>ETAPA</th>
                                        <th>USUARIO</th>
                                        <th>ESTADO</th>
                                        <th>COMENTARIO</th>
                                        <th>FECHA</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody_aprobaciones"></tbody>
                            </table>
                        </div>
                        <br />
                        <div class="row justify-content-end">
                            <div class="d-flex flex-row-reverse gap-1">

                                <button type="button" class="btn btn-danger pull-right" onclick="CerrarModalAprobar();">Cerrar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="~/Scripts/ChequeTest/ChequeTest.js" asp-append-version="true"></script>