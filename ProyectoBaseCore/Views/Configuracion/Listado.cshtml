@{
    ViewBag.Title = "Configuracion";
}

<div class="container-fluid" style="height:93%;">
    <div class="card">
        <div class="card-body">
            <div class="row justify-content-between">
                <div class="col-md-3">
                    <h3>Configuración</h3>
                </div>
                <div class="col-md-3">
                    <div class="col-xs-6 float-end">
                        <button id="btnSave" class="btn btn-primary-custom" onclick="Guardar()"><i class="fa-solid fa-floppy-disk"></i>  Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="border rounded p-3 position-relative mt-4">
        <span class="position-absolute bg-white px-2" style="top:-12px; left:15px;">
            Datos de la Empresa
        </span>
        <div class="row">
            <div class='col-md-6'>
                <label for='txtRuc' class="control-label col-sm-4 left-align">RUC</label>
                <div class="col-sm-12">
                    <input id='txtRuc' name="txtRuc" type='text' class="form-control form-control-modern smcImputValidacion" tabindex="1">
                    <small id="error-txtRuc" class="text-danger d-none smcLabelValidacion"></small>
                </div>
            </div>
            <div class='col-md-6'>
                <label for='txtRazonSocial' class="control-label col-sm-4 left-align">Razón Social</label>
                <div class="col-sm-12">
                    <input id='txtRazonSocial' name="txtRazonSocial" type='text' class="form-control form-control-modern smcImputValidacion" tabindex="2">
                    <small id="error-txtRazonSocial" class="text-danger d-none smcLabelValidacion"></small>
                </div>
            </div>
        </div>
    </div>

    <div class="border rounded p-3 position-relative mt-4">
        <span class="position-absolute bg-white px-2" style="top:-12px; left:15px;">
            Datos para Envío de Correo
        </span>
        <div class="row">
            <div class='col-md-4'>
                <label for='txtServerSMTP' class="control-label col-sm-4 left-align">Servidor SMTP</label>
                <div class="col-sm-12">
                    <input id='txtServerSMTP' name="txtServerSMTP" type='text' class="form-control form-control-modern smcImputValidacion" tabindex="3">
                    <small id="error-txtServerSMTP" class="text-danger d-none smcLabelValidacion"></small>
                </div>
            </div>
            <div class='col-md-4'>
                <label for='txtPortSMTP' class="control-label col-sm-4 left-align">Puerto SMTP</label>
                <div class="col-sm-12">
                    <input id='txtPortSMTP' name="txtPortSMTP" type='number' class="form-control form-control-modern smcImputValidacion" tabindex="4">
                    <small id="error-txtPortSMTP" class="text-danger d-none smcLabelValidacion"></small>
                </div>
            </div>
            <div class='col-md-4'>
                <label for='cboSSLSMTP' class="control-label col-sm-4 left-align">SSL SMTP</label>
                <div class="col-sm-12">
                    <select id='cboSSLSMTP' name="cboSSLSMTP" type='text' class="form-select form-control-modern smcImputValidacion" tabindex="5">
                        <option value="0">NO</option>
                        <option value="1">SI</option>
                    </select>
                    <small id="error-cboSSLSMTP" class="text-danger d-none smcLabelValidacion"></small>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class='col-md-6'>
                <label for='txtEmailSMTP' class="control-label col-sm-4 left-align">Email SMTP</label>
                <div class="col-sm-12">
                    <input id='txtEmailSMTP' name="txtEmailSMTP" type='text' class="form-control form-control-modern smcImputValidacion" tabindex="6">
                    <small id="error-txtEmailSMTP" class="text-danger d-none smcLabelValidacion"></small>
                </div>
            </div>
            <div class='col-md-6'>
                <label for='txtPasswordSMTP' class="control-label col-sm-4 left-align">Contraseña SMTP</label>
                <div class="col-sm-12">
                    <input id='txtPasswordSMTP' name="txtPasswordSMTP" type='password' class="form-control form-control-modern smcImputValidacion" tabindex="7">
                    <small id="error-txtPasswordSMTP" class="text-danger d-none smcLabelValidacion"></small>
                </div>
            </div>
        </div>
        <br />
        <div>
            <button id="btnTestEmail" class="btn btn-primary-custom" onclick="EnviarTestEmail()"><i class="fa-solid fa-envelope"></i>  Enviar Email de Prueba</button>
        </div>
    </div>


</div>


<script src="~/Scripts/Configuracion/Listado.js" asp-append-version="true"></script>
