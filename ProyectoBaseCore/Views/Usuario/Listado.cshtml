@{
    ViewBag.Title = "Usuarios";
}

<style>
    table th {
        color: white;
        border-color: #bcecf1;
        background-color: #2d4b67;
    }
</style>

<div class="container-fluid" style="height:93%;">
    <div class="card">
        <div class="card-body">
            <div class="row justify-content-between">
                <div class="col-md-3">
                    <div class="topbar-left col-xs-6">
                        <h3>Usuarios</h3>
                    </div>
                    <div class="col-xs-6">
                        <div class="topbar-left col-xs-6">
                            <p class="text-muted mb-0">
                                Total de Registros: <span id="spnTotalRegistros"></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="col-xs-6 float-end">
                        <button class="btn btn-primary-custom" onclick="ModalNuevo()"><i class="fa-solid fa-user-plus"></i>  Nuevo</button>
                    </div>
                </div>
            </div>
        </div>


    </div>
    <br />
    <div class="card">
        <div class="card-body">

            <table id="table_id" class="table table-modern table-sm bg-white mb-0" style="width:100%;">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Usuario</th>
                        <th>Perfil</th>
                        <th>Estado</th>

                        <th>Mas</th>
                    </tr>
                </thead>
                <tbody id="tbody_Usuarios"></tbody>
            </table>

        </div>
    </div>

    <div class="modal fade" id="modal-form" data-bs-keyboard="false" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id='lblTituloModal'>
                    </h5>
                </div>
                <div class="card">
                    <div class="card-body">
                        <div class='col s12 m12 '>
                            <div class=''>
                                <input id='txtId' name="txtId" type='hidden' class="form-control input-sm">
                                <div class='form-horizontal'>
                                    <div class="row">
                                        <div class='col-md-12'>
                                            <label for='txtNombre' class="control-label col-sm-4 left-align">Nombre</label>
                                            <div class="col-sm-12" style="padding-bottom:10px">
                                                <input class="form-control form-control-modern smcImputValidacion" id="txtNombre" name="txtNombre" type='text' tabindex="1" />
                                                <small id="error-txtNombre" class="text-danger d-none smcLabelValidacion"></small>
                                            </div>
                                        </div>

                                    </div>


                                    <div class="row">
                                        <div class='col-md-6'>
                                            <label for='txtUsuario' class="control-label col-sm-4 left-align">Usuario</label>
                                            <div class="col-sm-12" style="padding-bottom:10px">
                                                <input id='txtUsuario' name="txtUsuario" type='text' class="form-control form-control-modern smcImputValidacion" tabindex="2">
                                                <small id="error-txtUsuario" class="text-danger d-none smcLabelValidacion"></small>
                                            </div>
                                        </div>
                                        <div class='col-md-6'>
                                            <label for='txtContraseña' class="control-label col-sm-4 left-align">Contraseña</label>
                                            <div class="col-sm-12" style="padding-bottom:10px">
                                                <input id='txtContraseña' name="txtContraseña" type='text' class="form-control form-control-modern smcImputValidacion" tabindex="3">
                                                <small id="error-txtContraseña" class="text-danger d-none smcLabelValidacion"></small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">

                                        <div class="col-md-6">
                                            <label for='txtCorreo' class="control-label col-sm-12 left-align">Correo Electronico</label>
                                            <div class="col-sm-12">
                                                <input id='txtCorreo' name="txtCorreo" type='text' class="form-control form-control-modern smcImputValidacion" tabindex="4">
                                                <small id="error-txtCorreo" class="text-danger d-none smcLabelValidacion"></small>

                                            </div>
                                        </div>
                                        <div class='col-md-6'>
                                            <label for='cboPerfil' class="control-label col-sm-4 left-align">Perfil</label>
                                            <div class="col-sm-12">
                                                <select id="cboPerfil" style="width:100%" name="cboPerfil" class="form-select form-control-modern smcImputValidacion" tabindex="5"></select>
                                                <small id="error-cboPerfil" class="text-danger d-none smcLabelValidacion"></small>
                                            </div>
                                        </div>

                                    </div>
                                    <br />
                                    <div class="row">
                                        <div class='col-sm-12 mb-3'>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="chkActivo" tabindex="6" checked>
                                                <label class="form-check-label" for="chkActivo ">
                                                    Activo
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <br />

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class=" modal-footer justify-content-end bg-light">
                    <div class="d-flex flex-row-reverse gap-1">
                        <button type="button" id="btnGrabar" onclick="GuardarUsuario()" class="btn btn-primary pull-right plu">Grabar</button>
                        <button type="button" id="btnCancelar" class="btn btn-outline-danger pull-right" onclick="CerrarModal();">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="~/Scripts/Usuario/Usuario.js" asp-append-version="true"></script>