@{
    ViewBag.Title = "Estado de Muestras LIMS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .selected-row {
        background-color: rgba(0, 50, 100, 0.08) !important;

        td {
            background-color: rgba(0, 50, 100, 0.08) !important;
        }
    }

    .table-modern tbody tr {
        cursor: pointer;
    }
</style>

<div class="page-content">
    <div class="container-fluid">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="text-primary mb-0" style="font-weight: 700;">Monitoreo de Muestras LIMS</h4>
                <p class="text-muted" style="font-size: 0.85rem;">Consulta en tiempo real el estado de las muestras integradas con SAP.</p>
            </div>
            <div class="d-flex gap-2">
                <button id="btnProcesarSap" class="btn btn-primary-custom d-none" onclick="prepararEnvioSap()">
                    <i class="bi bi-box-arrow-right me-2"></i> Procesar a SAP (<span id="selectedCount">0</span>)
                </button>
                <button class="btn btn-primary-outline-custom" onclick="dtMuestras.ajax.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Actualizar
                </button>
            </div>
        </div>

        <!-- Filtros Rápidos (Opcional) -->
        <div class="card card-config mb-3 shadow-sm" style="border-left: 3px solid var(--secondary-brand-color);">
            <div class="card-body p-3">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <span class="badge rounded-pill bg-warning text-dark">Leyenda</span>
                    </div>
                    <div class="col">
                        <small class="text-muted me-3"><i class="bi bi-circle-fill text-success"></i> Completado</small>
                        <small class="text-muted me-3"><i class="bi bi-circle-fill text-primary"></i> En Proceso</small>
                        <small class="text-muted"><i class="bi bi-circle-fill text-danger"></i> Cancelado</small>
                    </div>
                </div>



            </div>

        </div>

        <div class="row mb-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label-custom">Filtrar por Estado</label>
                <select id="cmbFiltroEstado" class="form-select form-control-modern">
                    <option value="">[ TODOS LOS ESTADOS ]</option>
                    <option value="SIN_FINALIZAR">SIN FINALIZAR</option>
                    <option value="FINALIZADO">FINALIZADO</option>
                </select>
            </div>
        </div>

        <!-- Tabla Principal -->
        <div class="card card-config shadow-sm">
            <div class="card-body card-body-config">
                <table id="tblMuestras" class="table table-modern w-100">
                    <!-- Columnas dinámicas -->
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para ver Observaciones/Detalles -->
<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-content-custom">
            <div class="modal-header modal-header-custom">
                <h5 class="modal-title modal-title-custom text-primary">Detalles de la Muestra</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="detalleContenido">
                    <!-- Se llena dinámicamente -->
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Services/EstadoMuestrasPreFTService.js"></script>

    <script>
        let dtMuestras;

        window.onload = async () => {
            initTabla();
                 UI.$("#cmbFiltroEstado").addEventListener("change", () => {
            dtMuestras.ajax.reload();
               });

        };

               function initTabla() {
            const formatFecha = (str) => {
                if (!str) return '<span class="text-muted">---</span>';
                const d = new Date(str);
                return d.toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit', year: 'numeric' });
            };

            dtMuestras = $('#tblMuestras').DataTable({
                serverSide: true,
                processing: true,
                searchDelay: 1500,
                ajax: async (d, cb) => {

                    const $wrapper = $('#tblMuestras_wrapper');
                    $wrapper.css('opacity', '0.5').css('pointer-events', 'none');

                    try {
                          const extraParams = {
                            Estado: UI.$("#cmbFiltroEstado").value
                           };


                        const res = await EstadoMuestrasService.Listar(d, extraParams, {cancelPrevious: true});
                        cb(res);
                    }
                    catch(err) {
                        console.log(err);
                             if (err.name === 'AbortError') return;
                    }
                    finally {
                        $wrapper.css('opacity', '1').css('pointer-events', 'auto');
                    }
                },
                  select: {
                    style: 'multi',
                    selector: 'td:first-child'
                },
                autoWidth: false,
                scrollX: true,
                scrollY: "360px",
                columns: [
                      {
                title: "",
                data: null,
                defaultContent: "",
                orderable: false,
                className: 'select-checkbox text-center',
                width: "30px",
                render: () => `<input type="checkbox" class="form-check-input chk-muestra" style="pointer-events: none !important;">`
            },
                    {
                        title: "#",
                        render: (data, type, row, meta) => `<span class="text-muted">${meta.row + meta.settings._iDisplayStart + 1}</span>`,
                        width: "30px",
                        className: "text-center"
                    },
                    {
                        title: "Cliente (SAP)",
                        render: (data, type, row) => {
                            const ruc = row.ClienteRuc || '---';
                            const nombre = row.ClienteRazonSocial || 'SIN MATCH';
                            return `
                                <div class="d-flex flex-column">
                                    <small class="fw-bold text-secondary">${ruc}</small>
                                    <span class="text-truncate" style="max-width: 200px;">${nombre}</span>
                                </div>`;
                        }
                    },
                       { data: "Customer", title: "Cliente LIMS #", className: "text-center" },
                    { data: "Project", title: "Proyecto", render: (data) => data || '---' },
                    { data: "SampleNumber", title: "Muestra LIMS #", render: (data) => data || '---' },
                    { data: "ReportNumber", title: "Reporte #", className: "text-center" },
                    {
                        data: "Description",
                        title: "Desc. Muestra LIMS",
                        render: (data) => `<small class="text-wrap" style="min-width: 150px; display:block;">${data}</small>`
                    },
                    { data: "Analysis", title: "Análisis" },
                    { data: "CostItemTl", title: "Cod. Paquete Lims" },
                    { data: "TestListName", title: "Desc. Paquete Lims" },
                    {
                        data: "ArticuloDescripcion",
                        title: "Desc. Análisis (SAP)",
                        render: (data) => data ? `<span class="text-primary">${data}</span>` : '<small class="text-muted">Sin match</small>'
                    },
                      {
                        data: null,
                        title: "Pedido #(SAP)",
                        render: (data, type, row) => {
                               if(row.DocNumSAP && row.SeriesSAP) {
                                    return `<span class="text-success">${row.SeriesSAP}-${row.DocNumSAP}</span>`
                               }
                                return '<small class="text-muted">Sin Procesar</small>'
                        }

                    },
                    {
                        data: "XFechaIni",
                        title: "F. Inicio",
                        render: formatFecha
                    },
                    {
                        data: "StatusLims",
                        title: "Estado",
                        className: "text-center",
                        render: (data) => {
                            let color = "secondary";
                            if(data === "FINALIZADO") color = "success";
                            if(data === "SIN FINALIZAR") color = "primary";

                            // TODO: danger para cuando sepamos como es cancelado en la vista
                            if(data === "X") color = "danger";
                            return `<span class="badge rounded-pill bg-${color}">${data}</span>`;
                        }
                    },
                    {
                        data: "FechaEmision",
                        title: "F. Emisión",
                        render: formatFecha
                    },
                    {
                        data: "FechaAprobacion",
                        title: "F. Aprobación",
                        render: formatFecha
                    },
                     {
                title: "Acciones",
                className: "text-end",
                render: (data, type, row) => {
                 let html = `   <div class="action-buttons">
                        <button class="btn-ghost btn-ghost-edit" title="Procesar individual" onclick="procesarFilaIndividual('${row.CardCodeSAP}', '${row.ItemCodeSAP}', '${row.Project}', '${row.Analysis}', '${row.SampleNumber}',  '${row.CostItemTl}', '${row.Customer}')">
                            <i class="bi bi-send-plus"></i>
                        </button>
                    </div>`;
                    return html;
                }
            }
                ],
                columnDefs: [
                    { targets: "_all", defaultContent: "---" }
                ],
                language: {
                    searchPlaceholder: "Buscar por descripción o ID..."
                }
            });

      
            //       $('#tblMuestras tbody').on('change', '.chk-muestra', function() {
            // $(this).closest('row').toggleClass('selected');
            // actualizarEstadoBotonProcesar();
            //       });

                      $('#tblMuestras tbody').on('click', 'tr', function (e) {
            if ($(e.target).closest('td').index() === 0 || $(e.target).closest('.dt-control').length > 0) return;

            const chk = $(this).find('.chk-muestra');
            chk.prop('checked', !chk.prop('checked'));
            $(this).toggleClass('selected-row', chk.prop('checked'));
            actualizarEstadoBotonProcesar();
        });

        }

              function actualizarEstadoBotonProcesar() {
            const seleccionados = obtenerSeleccionados();
            const btn = UI.$("#btnProcesarSap");
            const countSpan = UI.$("#selectedCount");

            if (seleccionados.length > 0) {
                btn.classList.remove("d-none");
                countSpan.innerText = seleccionados.length;
            } else {
                btn.classList.add("d-none");
            }
        }

        function obtenerSeleccionados() {
            const data = [];
            const rows = dtMuestras.rows().nodes();

                $(rows).each(function(idx, node) {
            if ($(node).find('.chk-muestra').is(':checked')) {
                const rowData = dtMuestras.row(node).data();
                data.push({
                    Project: rowData.Project,
                    Customer: rowData.Customer,
                    Analysis: rowData.Analysis,
                    SampleNumber: rowData.SampleNumber,
                    CardCodeSAP: rowData.CardCodeSAP,
                    CostItemTl: rowData.CostItemTl,
                    ItemCodeSAP: rowData.ItemCodeSAP
                });
            }
        });
        return data;
        }

        async function prepararEnvioSap() {
            const seleccionados = obtenerSeleccionados();

            const rucs = [...new Set(seleccionados.map(s => s.CardCodeSAP))];


            if (rucs.length > 1 || rucs[0] === "---") {
                Swal.fire("Error", "Solo puede procesar muestras de un mismo cliente a la vez para generar un pedido único.", "error");
                return;
            }
            console.log(rucs);
            if (!rucs[0]) {
                Swal.fire("Atención", "Las muestras seleccionadas no tienen un cliente SAP vinculado.", "warning");
                return;
            }

            const confirm = await Swal.fire({
                title: '¿Procesar a SAP?',
                text: `Se creará una Orden de Venta para el cliente ${rucs[0]} con ${seleccionados.length} análisis.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, enviar',
                cancelButtonText: 'Cancelar'
            });

            if (confirm.isConfirmed) {
        const payload = {
              CardCode: rucs[0],
              ItemCodes: seleccionados.map(s => s.ItemCodeSAP),
              Muestras: seleccionados.map(s => ({
                  Project: s.Project,
                  Customer: s.Customer,
                  Analysis: s.Analysis,
                  SampleNumber: s.SampleNumber,
                  CostItemTl: s.CostItemTl,
                  ItemCodeSAP: s.ItemCodeSAP,
              }))
          };


           Swal.fire({
            title: 'Procesando...',
            text: 'Por favor espere mientras se genera el pedido.',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

                

                UI.$("#btnProcesarSap").disabled = true;
                const res = await EstadoMuestrasService.ProcesarMuestrasASap(payload);
                UI.$("#btnProcesarSap").disabled = false;
                Swal.close();

            
                if (res.Exito) {
                    console.log(res.Datos);
                    Swal.fire("Éxito", `Orden de Venta creada correctamente. SAP DocNum #: ${res.Datos.Series}-${res.Datos.DocNum}`, "success");
                    dtMuestras.ajax.reload(null, false);
                }
            }
        }

        async function procesarFilaIndividual(CardCodeSAP, ItemCodeSAP, Project, Analysis, SampleNumber,  CostItemTl, Customer) {

            if (!CardCodeSAP || CardCodeSAP  === 'null') {
                return Swal.fire("Atención", "Esta muestra no tiene un cliente vinculado.", "warning");
            }

                const datosMuestra = {
                     Project: Project,
                    Customer: Customer,
                    Analysis: Analysis,
                    SampleNumber: SampleNumber,
                    CostItemTl: CostItemTl,
                    ItemCodeSAP: ItemCodeSAP
                }

            const payload = {
                CardCode: CardCodeSAP,
                ItemCodes: [ItemCodeSAP],
                Muestras: [datosMuestra]
            };

            Swal.fire({
            title: 'Procesando...',
            text: 'Por favor espere mientras se genera el pedido.',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
     
            const res = await EstadoMuestrasService.ProcesarMuestrasASap(payload);
            if (res.Exito) {
                Swal.fire("Éxito", `Pedido SAP #${res.Datos.Series}-${res.Datos.DocNum} generado para el análisis ${ItemCodeSAP}`, "success");
                dtMuestras.ajax.reload(null, false);
            } 
        }
    </script>
}
