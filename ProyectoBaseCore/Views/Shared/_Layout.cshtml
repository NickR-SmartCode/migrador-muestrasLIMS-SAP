    @*@Scripts.Render("~/bundles/LayoutScripts")*@
    <script>
        
        window.AppConfig = {
            BaseURL: "@Url.Content("~")"
        };
    
        const link = window.location.href
        let url
        let href="";
    
        document.addEventListener("DOMContentLoaded", function (event) {
            setTimeout(function () {
                document.getElementById("loader").classList.toggle("loader2");
            }, 1500);
            ObtenerAccesoMenuxPerfil()

                    document.querySelector(".sidebar-toggler").addEventListener("click", function() {
            document.body.classList.toggle("sidebar-folded");
        });
        });


        let menu
        let controller

        function ObtenerAccesoMenuxPerfil() {
            $.ajax({
                url: "/Menu/ObtenerMenuxPerfil",
                method: "POST",
                data: {},
               success: function (data) {
                    if (data == "Error") {
                        swal("Error!", "Ocurrio un error")
                    } else {
                        let tr = '<li class="nav-item nav-category">Menú</li>';
                        let perfiles = (data);

                        //console.log(perfiles)
                        for (var i = 0; i < perfiles.length; i++) {
                            if (data) {
                                let valor = perfiles[i].Descripcion.split(" ").join("") + 's';
                                menu = perfiles[i].Menu
                                controller = perfiles[i].Controller
                                let iconoMenu = '';
                                let logoMenu = '';
                                switch (perfiles[i].Descripcion.toUpperCase()) {
                                    case 'SEGURIDAD': iconoMenu = 'fa-solid fa-user-shield'
                                        break;
                                    case 'GESTION': iconoMenu = 'fa-solid fa-table'
                                        break;
                                    case 'INTEGRACIÓN LIMS': iconoMenu = 'fa-solid fa-vials'
                                        break;
                                    case 'PRUEBAS APROBACIONES': iconoMenu = 'fa-solid fa-check-double'
                                        break;
                                    case 'PEDIDOS': iconoMenu = 'fa-solid fa-file-invoice'
                                        break;
                                          case 'DASHBOARD': iconoMenu = 'fa-solid fa-chart-simple'
                                        break;
                                    case 'Socio Negocio': iconoMenu = 'fa-solid fa-people-group'
                                        break;
                                    case 'Venta Clientes': iconoMenu = 'fa-solid fa-cart-shopping'
                                        break;
                                    case 'Inventario': iconoMenu = 'fa-solid fa-warehouse'
                                        break;
                                    case 'Requerimiento': iconoMenu = 'fa-solid fa-clipboard-check'
                                        break;
                                    case 'Administracion': iconoMenu = 'fa-solid fa-briefcase'
                                        break;
                                    case 'Compras': iconoMenu = 'fa-solid fa-cart-flatbed'
                                        break;
                                    case 'Compras y Almacén': iconoMenu = 'fa-solid fa-cart-flatbed'
                                        break;
                                    case 'Aprobaciones': iconoMenu = 'fa-solid fa-list-check'
                                        break;
                                    case 'Integrador': iconoMenu = 'fa-solid fa-laptop-code'
                                        break;
                                    case 'Finanzas': iconoMenu = 'fa-solid fa-sack-dollar'
                                        break;
                                    case 'Gestion de Bancos': iconoMenu = 'fa-solid fa-building-columns'
                                        break;
                                    case 'Logistica': iconoMenu = 'fa-solid fa-truck-fast'
                                        break;
                                    case 'Portal Proveedores':
                                          logoMenu = `
                                        <img src="@baseUrl/images/portal-proveedores/09-isotipo-positivo(2).png"
                                        style="height: 12px"
                                        />
                                        `
                                        break;
                                    case 'Comunicados': iconoMenu = 'fa-solid fa-bullhorn'
                                        break;
                                    case 'SIRE': iconoMenu = 'fas fa-share-alt-square'
                                        break;
                                    case 'Ventas': iconoMenu = 'fa-solid fa-shopping-cart'
                                        break;

                                    case 'SmartLogistics':
                                        logoMenu = `
                                        <img src="@baseUrl/images/smartlogistics/isotipo-original(2).png"
                                        style="height: 12px"
                                        />
                                        `

                                        break;


                                    default: iconoMenu = 'fa-solid fa-question'

                                }
                                tr += '<li class="nav-item">'
                                tr += '<a class="nav-link collapsed" data-bs-toggle="collapse" href="#' + valor + '" role="button" aria-expanded="false" aria-controls="' + valor + '">'
                                tr += (logoMenu != '' ? logoMenu : '<i class="' + iconoMenu + '"></i>');
                                tr += '<span class="link-title">' + perfiles[i].Descripcion.toUpperCase() + '</span>'
                                tr += '<i class="fa-solid fa-chevron-down link-arrow" style="font-size: 10px !important"></i>';

                                tr += '</a>'



                                tr += '<div class="collapse" id="' + valor + '" style> <ul class="nav sub-menu">'

                                for (var j = 0; j < perfiles[i].Items.length; j++) {

                                    if (perfiles[i].Items[j].ItemsSubMenu == 0 || perfiles[i].Items[j].ItemsSubMenu == null) {
                                        tr += '<li class="nav-item">'
                                        // tr += '<a class="nav-link" href="/' + href + perfiles[i].Items[j].Controller + '/Listado">' + perfiles[i].Items[j].Descripcion + ' </a> '
                                        tr += '<a class="nav-link" href="/' + href + perfiles[i].Items[j].Controller + '/' + perfiles[i].Items[j].Action + '">' + perfiles[i].Items[j].Descripcion + ' </a> '
                                        tr += '</li>'
                                    } else {

                                        tr += '<li class="nav-item">'
                                        tr += '<a class="nav-link collapsed" data-bs-toggle="collapse" href="#' + valor + j.toString() + '" role="button" aria-expanded="false" aria-controls="' + valor + j.toString() + '">'
                                        //tr += '<i class="' + iconoMenu + '"></i>'
                                        tr += '<span style="margin-left:0px" class="link-title">' + perfiles[i].Items[j].Descripcion + '  </span>'
                                        tr += '<i class="fa-solid fa-chevron-down link-arrow" style="font-size: 10px !important"></i>';
                                        //tr += '<i class="fa-solid fa-chevron-down" link-arrow></i>'
                                        tr += '</a>'

                                        // MODIFICACION: Eliminé estilos inline para permitir que el CSS controle el diseño
                                        tr += '<div class="collapse" id="' + valor + j.toString() + '" style> <ul class="nav sub-menu">'
                                        for (var k = 0; k < perfiles[i].Items[j].ItemsSubMenu.length; k++) {
                                            //let a = perfiles[i].Items[j].ItemsSubMenu[k]
                                            //console.log(a)
                                            if (perfiles[i].Items[j].ItemsSubMenu[k].ItemsSubMenu2 == 0 || perfiles[i].Items[j].ItemsSubMenu[k].ItemsSubMenu2 == null) {
                                                tr += '<li class="nav-item">'
                                                // MODIFICACION: Eliminé estilos inline (color:black, margin-left)
                                                tr += '<a class="nav-link" href="/' + href + perfiles[i].Items[j].ItemsSubMenu[k].Controller + '/' + perfiles[i].Items[j].ItemsSubMenu[k].Action + '">' + perfiles[i].Items[j].ItemsSubMenu[k].Descripcion + ' </a> '
                                                tr += '</li>'
                                            } else {
                                                tr += '<li class="nav-item">'
                                                tr += '<a class="nav-link collapsed" data-bs-toggle="collapse" href="#' + valor + j.toString() + k.toString() + '" role="button" aria-expanded="false" aria-controls="' + valor + j + k.toString() + '">'
                                                //tr += '<i class="' + iconoMenu + '"></i>'
                                                tr += '<span style="margin-left:0px" class="link-title">' + perfiles[i].Items[j].ItemsSubMenu[k].Descripcion + ' </span>'
                                                tr += '<i class="fa-solid fa-chevron-down link-arrow" style="font-size: 10px !important"></i>';
                                                //tr += '<i class="fa-solid fa-chevron-down" link-arrow></i>'
                                                tr += '</a>'


                                                // MODIFICACION: Eliminé estilos inline
                                                tr += '<div class="collapse" id="' + valor + j.toString() + k.toString() + '" style> <ul class="nav sub-menu">'
                                                for (var l = 0; l < perfiles[i].Items[j].ItemsSubMenu[k].ItemsSubMenu2.length; l++) {
                                                    tr += '<li class="nav-item">'
                                                    // MODIFICACION: Eliminé estilos inline
                                                    tr += '<a class="nav-link" href="/' + href + perfiles[i].Items[j].ItemsSubMenu[k].ItemsSubMenu2[l].Controller + '/' + perfiles[i].Items[j].ItemsSubMenu[k].ItemsSubMenu2[l].Action + '">' + perfiles[i].Items[j].ItemsSubMenu[k].ItemsSubMenu2[l].Descripcion + ' </a> '
                                                    tr += '</li>'


                                                }
                                                tr += '</ul> </div>'
                                            }
                                        }


                                        tr += '</ul> </div>'
                                    }

                                }

                                tr += '</ul> </div>'

                                tr += ' </li>'
                            }
                        }
                        $("#ulMenuPr").html(tr);

                        setTimeout(function () {
                            var currentPath = window.location.pathname.toLowerCase();

                            var $activeLink = $("#ulMenuPr a.nav-link").filter(function () {
                                var href = $(this).attr("href");
                                return href && href.toLowerCase() === currentPath;
                            });

                            if ($activeLink.length > 0) {

                                $activeLink.addClass("active");

                                $activeLink.parents(".collapse").addClass("show");

                                $activeLink.parents(".collapse").each(function () {
                                    var menuId = $(this).attr("id");

                                    var $parentToggler = $('a[href="#' + menuId + '"]');

                                    $parentToggler.attr("aria-expanded", "true");
                                    $parentToggler.removeClass("collapsed");

                                    $parentToggler.addClass("parent-active");
                                });

                                $activeLink[0].scrollIntoView({ block: "center", behavior: "smooth" });
                            }
                        }, 100);
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    if (jqXHR.status === 401) {
                        manejarTokenExpirado();
                    } else {
                        try {
                            var err = JSON.parse(jqXHR.responseText);
                            Swal.fire("Error", "Error " + jqXHR.status + ": " + err.message, "error")
                        } catch (e) {
                            Swal.fire("Error", "Error " + jqXHR.status + ": " + jqXHR.responseText, "error")
                        }
                    }
                }
            });


        }
        function MostrarSubMenu(menu, perfiles, valor) {
            tr = '<div class="collapse" id="' + valor + '" style> <ul class="nav sub-menu">'
            for (var i = 0; i < perfiles.length; i++) {
                if (perfiles[i].Menu == menu && perfiles[i].Acceso == 0) {
                    menu = perfiles[i].Menu
                    tr += '<li class="nav-item"> '
                    //LOCAL
                    //tr += '<a class="nav-link" href="/' + perfiles[i].Controller + '">' + perfiles[i].Descripcion + ' </a> '
                    //SMC IP
                    tr += '<a class="nav-link" href="/' + href + perfiles[i].Controller + '">' + perfiles[i].Descripcion + ' </a> '
                    tr += '</li>'
                }
            }
            tr += '</ul> </div>'
            return tr

        }

    </script>

