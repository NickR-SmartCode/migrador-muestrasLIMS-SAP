@{
    string NombreUsuario = ViewBag.NombreUsuario as string ?? "";
    string RazonSocial = ViewBag.RazonSocial as string ?? "";
    string SubDominio = ViewBag.SubDominio as string ?? "";

    var request = Context.Request;

    string esquema = request.Scheme;
    string host = request.Host.Host;
    int? puerto = request.Host.Port;

    string baseUrl = $"{esquema}://{host}" +
        ((puerto.HasValue && puerto != 80 && puerto != 443) ? $":{puerto}" : "");
}


