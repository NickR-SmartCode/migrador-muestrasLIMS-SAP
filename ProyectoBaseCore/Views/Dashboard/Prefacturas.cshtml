@{
    ViewBag.Title = "Dashboard de Prefacturas LIMS - SAP";
}

<div id="dashboard-container" class="page-content bg-dashboard py-4">
    <div class="container-fluid">
        
        
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
                <h3 class="fw-bolder text-corporate mb-1">Dashboard de Prefacturas</h3>
                <p class="text-muted small mb-0 d-flex align-items-center gap-2">
                    <span class="pulse-dot"></span> Integración LIMS a SAP B1
                </p>
            </div>
            <div class="d-flex gap-2">
                <div class="input-group shadow-sm border-0 rounded-3 overflow-hidden">
                    <span class="input-group-text bg-white border-0 text-primary"><i class="bi bi-calendar3"></i></span>
                    <select id="cmbAnio" class="form-select border-0 fw-semibold text-corporate" style="width: 120px; box-shadow: none;">
                    </select>
                </div>
                <button id="btnActualizar" class="btn btn-primary shadow-sm px-3 rounded-3 d-flex align-items-center gap-2 transition-all" onclick="cargarDashboard()">
                    <i class="bi bi-arrow-clockwise"></i> <span class="d-none d-sm-inline">Actualizar</span>
                </button>
            </div>
        </div>

        
        <div class="row g-4 mb-4">
            
            
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="card border-0 shadow-sm metric-card h-100 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="icon-shape bg-primary-soft text-primary skeleton">
                                <i class="bi bi-receipt"></i>
                            </div>
                            @Html.Partial("_SelectorMesWidget", "W1_Facturacion")
                        </div>
                        <h6 class="text-muted fw-semibold mb-1 text-uppercase tracking-wide skeleton w-100">Estado de Prefacturas</h6>
                        <h2 id="w1_principal" class="fw-bolder text-corporate mb-2 display-6 skeleton w-50">0</h2>
                        <div class="d-flex align-items-center text-secondary small fw-medium">
                            <span class="me-2 skeleton">Totales LIMS /</span>
                            <span class="badge bg-success-soft text-success rounded-pill px-2 py-1 skeleton">
                                <b id="w1_secundario">0</b> En SAP
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="card border-0 shadow-sm metric-card h-100 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="icon-shape bg-dark-soft text-dark skeleton">
                                <i class="bi bi-currency-dollar"></i>
                            </div>
                            @Html.Partial("_SelectorMesWidget", "W3_Match_Monto")
                        </div>
                        <h6 class="text-muted fw-semibold mb-1 text-uppercase tracking-wide skeleton w-100">Valorización de Prefacturas</h6>
                        <h2 id="w3_principal" class="fw-bolder text-corporate mb-2 fs-3 mt-2 skeleton w-75">S/ 0.00</h2>
                        <div class="d-flex align-items-center text-secondary small fw-medium">
                            <span class="me-2 skeleton">Facturado /</span>
                            <span class="badge bg-secondary-soft text-secondary rounded-pill px-2 py-1 skeleton">
                                <b id="w3_secundario">S/ 0.00</b> Potencial
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="card border-0 shadow-sm metric-card h-100 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="icon-shape bg-success-soft text-success skeleton">
                                <i class="bi bi-file-earmark-check-fill"></i>
                            </div>
                            @Html.Partial("_SelectorMesWidget", "W9_Facturacion_Detalle")
                        </div>
                        <h6 class="text-muted fw-semibold mb-1 text-uppercase tracking-wide skeleton w-100">Facturación en Firme</h6>
                        <h2 id="w9_principal" class="fw-bolder text-corporate mb-2 display-6 skeleton w-50">0</h2>
                        <div class="d-flex align-items-center text-secondary small fw-medium">
                            <span class="me-2 skeleton">Documentos /</span>
                            <span class="badge bg-success-soft text-success rounded-pill px-2 py-1 skeleton">
                                <b id="w9_secundario">S/ 0.00</b> Total
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            
            <div class="col-xl-3 col-lg-6 col-md-6">
                <div class="card border-0 shadow-sm metric-card h-100 bg-white">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="icon-shape bg-success-soft text-success skeleton">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                            @Html.Partial("_SelectorMesWidget", "W10_Facturacion_Detalle_Borrador")
                        </div>
                        <h6 class="text-muted fw-semibold mb-1 text-uppercase tracking-wide skeleton w-100">Facturación en Borrador</h6>
                        <h2 id="w10_principal" class="fw-bolder text-corporate mb-2 display-6 skeleton w-50">0</h2>
                        <div class="d-flex align-items-center text-secondary small fw-medium">
                            <span class="me-2 skeleton">Documentos /</span>
                            <span class="badge bg-success-soft text-success rounded-pill px-2 py-1 skeleton">
                                <b id="w10_secundario">S/ 0.00</b> Total
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        
        <div class="row g-4"  >
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm h-100 chart-card">
                    <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-corporate d-flex align-items-center gap-2 skeleton w-50">
                            <i class="bi bi-bar-chart-line text-primary"></i> Ranking de Análisis (Cant)
                        </h6>
                        @Html.Partial("_SelectorMesWidget", "W4_Cant_Analisis")
                    </div>
                    <div class="card-body p-4 pt-2">
                        <div class="position-relative w-100" style="height: 280px;">
                            <div class="chart-skeleton"></div>
                            <canvas id="chartw4cant_analisis"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" style="display: none !important">
                <div class="card border-0 shadow-sm h-100 chart-card" >
                    <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-corporate d-flex align-items-center gap-2 skeleton w-50">
                            <i class="bi bi-pie-chart text-success"></i> Ranking de Paquetes (Cant)
                        </h6>
                        @Html.Partial("_SelectorMesWidget", "W5_Cant_Paquete")
                    </div>
                    <div class="card-body p-4 pt-2">
                        <div class="position-relative w-100" style="height: 280px;">
                            <div class="chart-skeleton"></div>
                            <canvas id="chartw5cant_paquete"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" style="display: none !important">
                <div class="card border-0 shadow-sm h-100 chart-card">
                    <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-corporate d-flex align-items-center gap-2 skeleton w-50">
                            <i class="bi bi-graph-up text-info"></i> Monto Prefacturado por Análisis
                        </h6>
                        @Html.Partial("_SelectorMesWidget", "W6_Monto_Analisis")
                    </div>
                    <div class="card-body p-4 pt-2">
                        <div class="position-relative w-100" style="height: 280px;">
                            <div class="chart-skeleton"></div>
                            <canvas id="chartw6monto_analisis"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6" style="display: none !important">
                <div class="card border-0 shadow-sm h-100 chart-card">
                    <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-corporate d-flex align-items-center gap-2 skeleton w-50">
                            <i class="bi bi-pie-chart-fill text-warning"></i> Monto Prefacturado por Paquete 
                        </h6>
                        @Html.Partial("_SelectorMesWidget", "W7_Monto_Paquete")
                    </div>
                    <div class="card-body p-4 pt-2">
                        <div class="position-relative w-100" style="height: 280px;">
                            <div class="chart-skeleton"></div>
                            <canvas id="chartw7monto_paquete"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-12">
                <div class="card border-0 shadow-sm h-100 chart-card">
                    <div class="card-header bg-transparent border-0 pt-4 pb-2 px-4 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-corporate d-flex align-items-center gap-2 skeleton w-50">
                            <i class="bi bi-trophy text-danger"></i> Top Clientes (Por Cant. Prefacturas)
                        </h6>
                        @Html.Partial("_SelectorMesWidget", "W8_Ranking_Clientes")
                    </div>
                    <div class="card-body p-4 pt-2">
                        <div class="position-relative w-100" style="height: 300px;">
                            <div class="chart-skeleton"></div>
                            <canvas id="chartw8ranking_clientes"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<style>
       :root {
       --corp-bg: #f4f7fb;
       --corp-text: #1e293b;
       --corp-primary: #2563eb;
   }
   .bg-dashboard { background-color: var(--corp-bg) !important; font-family: 'Inter', 'Segoe UI', sans-serif; }
   .text-corporate { color: var(--corp-text) !important; }
   .tracking-wide { letter-spacing: 0.5px; font-size: 0.75rem; }
   
   .metric-card, .chart-card { 
       border-radius: 16px; 
       transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
       border: 1px solid rgba(0,0,0,0.04) !important;
   }
   .metric-card:hover { 
       transform: translateY(-5px); 
       box-shadow: 0 12px 24px rgba(0,0,0,0.06) !important; 
   }
   
   .icon-shape {
       width: 48px; height: 48px;
       border-radius: 12px;
       display: flex; align-items: center; justify-content: center;
       font-size: 1.5rem;
   }
   .bg-primary-soft { background-color: rgba(37, 99, 235, 0.1); }
   .bg-info-soft { background-color: rgba(14, 165, 233, 0.1); }
   .bg-success-soft { background-color: rgba(16, 185, 129, 0.1); }
   .bg-warning-soft { background-color: rgba(245, 158, 11, 0.1); }
   .bg-dark-soft { background-color: rgba(15, 23, 42, 0.08); }
   .bg-secondary-soft { background-color: rgba(100, 116, 139, 0.1); }
   
   .sel-mes-widget {
       font-size: 0.75rem;
       padding: 0.3rem 1.8rem 0.3rem 0.8rem;
       border-radius: 8px;
       background-color: var(--corp-bg);
       border: 1px solid rgba(0,0,0,0.05);
       color: #475569;
       font-weight: 600;
       cursor: pointer;
       transition: border-color 0.2s;
   }
   .sel-mes-widget:focus { border-color: var(--corp-primary); outline: none; }
   
   .pulse-dot {
       display: inline-block; width: 8px; height: 8px;
       border-radius: 50%; background-color: #10b981;
       box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
       animation: pulse 2s infinite;
   }
   @@keyframes pulse {
       0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
       70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
       100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
   }

  
   @@keyframes shimmer {
       0% { background-position: 200% 0; }
       100% { background-position: -200% 0; }
   }
   @@keyframes spin { 100% { transform: rotate(360deg); } }
   
   .spin-icon { animation: spin 1s linear infinite; }

   
   .is-loading .skeleton,
   .is-loading .sel-mes-widget {
       color: transparent !important;
       background: linear-gradient(90deg, #e2e8f0 25%, #f8fafc 50%, #e2e8f0 75%) !important;
       background-size: 200% 100% !important;
       animation: shimmer 1.5s infinite linear !important;
       border-radius: 0.375rem !important;
       border-color: transparent !important;
       pointer-events: none;
       box-shadow: none !important;
   }
   
   
   .is-loading .skeleton *,
   .is-loading .sel-mes-widget * {
       opacity: 0 !important;
       visibility: hidden !important;
   }

   
   .chart-skeleton {
       position: absolute;
       inset: 0;
       background: linear-gradient(90deg, #e2e8f0 25%, #f8fafc 50%, #e2e8f0 75%);
       background-size: 200% 100%;
       animation: shimmer 1.5s infinite linear;
       border-radius: 0.5rem;
       opacity: 0;
       visibility: hidden;
       transition: opacity 0.3s ease;
       z-index: 1;
   }
   
   .is-loading .chart-skeleton {
       opacity: 1;
       visibility: visible;
   }
   
   
   canvas { transition: opacity 0.5s ease; }
   .is-loading canvas { opacity: 0 !important; }
</style>

@section Scripts {
    <script>
        let charts = {};
        let rawData = null;

        
     const fmtMoneda = new Intl.NumberFormat('es-PE', { 
    style: 'currency', 
    currency: 'PEN', 
    minimumFractionDigits: 2 
});


        if (typeof Chart !== 'undefined') {
            Chart.defaults.font.family = "'Inter', 'Segoe UI', sans-serif";
            Chart.defaults.color = '#64748b';
        }

        document.addEventListener("DOMContentLoaded", () => {
            inicializarControlesDinámicos();
            cargarDashboard();

            document.getElementById("cmbAnio").addEventListener("change", () => {
                cargarDashboard();
            });
        });

        function inicializarControlesDinámicos() {
            const fechaActual = new Date();
            const anioActual = fechaActual.getFullYear();
            const mesActual = fechaActual.getMonth() + 1; 

            const cmbAnio = document.getElementById("cmbAnio");
            cmbAnio.innerHTML = ""; 
            
            for (let i = 0; i <= 100; i++) { 
                const anio = anioActual - i;
                const option = document.createElement("option");
                option.value = anio;
                option.textContent = anio;
                cmbAnio.appendChild(option);
            }
            cmbAnio.value = anioActual;

            const selectsMes = document.querySelectorAll(".sel-mes-widget");
            selectsMes.forEach(select => {
                select.value = mesActual;
            });
        }

        async function cargarDashboard() {
            const anio = document.getElementById("cmbAnio").value;
            const container = document.getElementById("dashboard-container");
            const btnUpdate = document.getElementById("btnActualizar");
            const iconUpdate = btnUpdate.querySelector("i");
            
            container.classList.add('is-loading');
            btnUpdate.disabled = true;
            iconUpdate.classList.add('spin-icon');

            try {
                await new Promise(r => setTimeout(r, 500)); 

                
                const res = await ApiService.ajax(`/Dashboard/ObtenerDatosPrefacturas?anio=${anio}`);
                
                if (res?.Exito) {
                    rawData = res.Datos;
                    renderizarTodoElDashboard();
                }
            } catch (error) {
                console.error("Error cargando dashboard:", error);
            } finally {
                container.classList.remove('is-loading');
                btnUpdate.disabled = false;
                iconUpdate.classList.remove('spin-icon');
            }
        }

        function renderizarTodoElDashboard() {
            if (!rawData) return;
            
            Object.keys(rawData).forEach(widgetKey => {
                const selectWidget = document.querySelector(`.sel-mes-widget[data-widget="${widgetKey}"]`);
                const mesFiltro = selectWidget ? parseInt(selectWidget.value) : 0; 
                
                filtrarWidgetLocal(widgetKey, mesFiltro);
            });
        }

        function filtrarWidgetLocal(widgetKey, mes) {
            if (!rawData || !rawData[widgetKey]) return;

            const mesInt = parseInt(mes);
            const infoWidget = rawData[widgetKey];

            if (widgetKey.startsWith('W1') || widgetKey.startsWith('W3') || widgetKey.startsWith('W9') || widgetKey.startsWith('W10')) {
                actualizarMetricaUI(widgetKey, infoWidget.ValoresMensuales, mesInt);
            } else {
                actualizarGraficaUI(widgetKey, infoWidget.Series, mesInt, infoWidget.Titulo);
            }
        }

        function actualizarMetricaUI(id, valoresMensuales, mes) {
            let principal = 0;
            let secundario = 0;

            if (mes === 0) {
                principal = valoresMensuales.reduce((acc, curr) => acc + curr.ValorPrincipal, 0);
                secundario = valoresMensuales.reduce((acc, curr) => acc + curr.ValorSecundario, 0);
            } else {
                const dataMes = valoresMensuales.find(x => x.Mes === mes);
                if (dataMes) {
                    principal = dataMes.ValorPrincipal;
                    secundario = dataMes.ValorSecundario;
                }
            }

            const prefix = id.split('_')[0].toLowerCase(); 
            const elPrincipal = document.getElementById(`${prefix}_principal`);
            const elSecundario = document.getElementById(`${prefix}_secundario`);

            
            if (id.includes('W1_Facturacion')) {
                elPrincipal.innerText = Math.round(principal);
                elSecundario.innerText = Math.round(secundario);
            }
            
            else if (id.includes('W3_Match_Monto')) {
                elPrincipal.innerText = fmtMoneda.format(principal);
                elSecundario.innerText = fmtMoneda.format(secundario);
            } 
            
            else if (id.includes('W9_Facturacion_Detalle') || id.includes('W10_Facturacion_Detalle_Borrador')) {
                elPrincipal.innerText = Math.round(principal);
                elSecundario.innerText = fmtMoneda.format(secundario);
            }
        }

        function actualizarGraficaUI(id, series, mes, titulo) {
            let datosFiltrados =[];

            if (mes === 0) {
                const agrupado = series.reduce((acc, curr) => {
                    if (!acc[curr.Etiqueta]) acc[curr.Etiqueta] = 0;
                    acc[curr.Etiqueta] += curr.Valor;
                    return acc;
                }, {});

                datosFiltrados = Object.keys(agrupado).map(key => ({
                    Etiqueta: key,
                    Valor: agrupado[key]
                }));
            } else {
                datosFiltrados = series.filter(x => x.Mes === mes);
            }

            datosFiltrados.sort((a, b) => b.Valor - a.Valor);
            
            datosFiltrados = datosFiltrados.slice(0, 10);

            const esMonto = id.includes('Monto');
            const tipo = (id === 'W6_Monto_Analisis' || id === 'W7_Monto_Paquete') ? 'doughnut' : 'bar';
            const color = id.includes('Analisis') ? '#2563eb' : (id.includes('Paquete') ? '#10b981' : '#6366f1');

            renderizarChartJS(id.toLowerCase().replace('_',''), tipo, datosFiltrados, color, esMonto);
        }

        function renderizarChartJS(canvasId, tipo, data, color, esMonto) {
            const chartId = `chart${canvasId}`;
            if (charts[chartId]) charts[chartId].destroy();

            const ctx = document.getElementById(chartId).getContext('2d');
            const doughnutColors =['#1e3a8a', '#2563eb', '#3b82f6', '#60a5fa', '#93c5fd', '#bfdbfe', '#e0f2fe', '#f8fafc', '#94a3b8', '#475569'];

            charts[chartId] = new Chart(ctx, {
                type: tipo,
                data: {
                    labels: data.map(x => x.Etiqueta),
                    datasets:[{
                        label: esMonto ? 'Monto' : 'Cantidad',
                        data: data.map(x => x.Valor),
                        backgroundColor: tipo === 'doughnut' ? doughnutColors : color,
                        borderWidth: tipo === 'doughnut' ? 2 : 0,
                        borderColor: '#ffffff',
                        borderRadius: tipo === 'bar' ? 6 : 0,
                        barPercentage: 0.6 
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: tipo === 'doughnut' ? '75%' : undefined,
                    plugins: {
                        legend: { 
                            display: tipo === 'doughnut', 
                            position: 'right',
                            labels: { usePointStyle: true, padding: 20 }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(15, 23, 42, 0.9)',
                            padding: 12,
                            cornerRadius: 8,
                            callbacks: {
                                label: (context) => {
                                    let val = context.parsed.y || context.parsed;
                                    return esMonto ? ` ${fmtMoneda.format(val)}` : ` ${val}`;
                                }
                            }
                        }
                    },
                    scales: tipo === 'bar' ? {
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 } }
                        },
                        y: {
                            border: { display: false },
                            grid: { color: 'rgba(0,0,0,0.04)' },
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    if(esMonto) return 'S/ ' + value;
                                    return value;
                                }
                            }
                        }
                    } : {}
                }
            });
        }
    </script>
}