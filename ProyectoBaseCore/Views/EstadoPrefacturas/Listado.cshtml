@{
    ViewBag.Title = "Estado de Muestras LIMS";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .selected-row {
        background-color: rgba(0, 50, 100, 0.08) !important;

        td {
            background-color: rgba(0, 50, 100, 0.08) !important;
        }
    }

    .table-modern tbody tr {
        cursor: pointer;
    }

     .btn-ver-mas-modern {
        background-color: rgba(0, 123, 255, 0.08);         color: #007bff;
        border: 1px solid rgba(0, 123, 255, 0.2);
        border-radius: 20px;         padding: 3px 10px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 5px;         margin-top: 6px;
        width: fit-content;
    }

    .btn-ver-mas-modern:hover {
        background-color: #007bff;
        color: white;
        box-shadow: 0 3px 8px rgba(0, 123, 255, 0.3);
        transform: translateY(-1px);     }

        .custom-overlay {
        position: fixed;
        top: 0; left: 0;
        width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: none;         justify-content: center;
        align-items: center;
        z-index: 9999;
        backdrop-filter: blur(2px);
    }

        .custom-modal-box {
        background: white;
        padding: 20px;
        border-radius: 8px;
        max-width: 500px;
        width: 90%;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        position: relative;
        animation: fadeIn 0.3s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .modal-header-custom {
        font-weight: bold;
        border-bottom: 1px solid #eee;
        margin-bottom: 15px;
        padding-bottom: 10px;
        display: flex;
        justify-content: space-between;
    }

    .btn-close-custom {
        cursor: pointer;
        border: none;
        background: none;
        font-size: 1.2rem;
    }

        .btn-ver-mas {
        background: none;
        border: none;
        color: #007bff;
        padding: 0;
        font-size: 0.75rem;
        text-decoration: underline;
        cursor: pointer;
    }
</style>

<div class="page-content">
    <div class="container-fluid">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="text-primary mb-0" style="font-weight: 700;">Monitoreo de Muestras LIMS</h4>
                <p class="text-muted" style="font-size: 0.85rem;">Consulta en tiempo real el estado de las muestras integradas con SAP.</p>
            </div>
            <div class="d-flex gap-2">
                <button id="btnProcesarSap" class="btn btn-primary-custom d-none" onclick="prepararEnvioSap()">
                    <i class="bi bi-box-arrow-right me-2"></i> Procesar a SAP (<span id="selectedCount">0</span>)
                </button>
                <button class="btn btn-primary-outline-custom" onclick="dtMuestras.ajax.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Actualizar
                </button>
            </div>
        </div>


        
        <div class="row mb-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label-custom">Cliente</label>
                <input type="text" id="txtFiltroRuc" class="form-control form-control-modern" placeholder="Buscar por RUC o Razón Social..." />
            </div>
            <div class="col-md-2">
                <label class="form-label-custom">Nro. Prefactura</label>
                <input type="text" id="txtFiltroNroPF" class="form-control form-control-modern" placeholder="Buscar por NroPF EJ: PF001-000121-26" />
            </div>
         
            <div class="col-auto">
                <button class="btn btn-primary w-100" onclick="dtMuestras.ajax.reload()">
                    <i class="bi bi-search"></i> Buscar
                </button>
            </div>
        </div>

        
        <div class="card card-config shadow-sm">
            <div class="card-body card-body-config">
                <table id="tblMuestras" class="table table-modern w-100">
                    
                </table>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalDetalle" tabindex="-1" aria-hidden="true">
</div>


<div id="myCustomModal" class="custom-overlay">
    <div class="custom-modal-box">
        <div class="modal-header-custom">
            <span>Detalle Completo</span>
            <button class="btn-close-custom" onclick="cerrarFlotante()">&times;</button>
        </div>
        <div id="myCustomContent" style="white-space: pre-wrap; word-break: break-word; max-height: 400px; overflow-y: auto; font-size: 0.9rem;">
            
        </div>
        <div style="text-align: right; margin-top: 20px;">
            <button class="btn btn-secondary btn-sm" onclick="cerrarFlotante()">Cerrar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Services/EstadoMuestrasPreFTService.js"></script>

    <script>
        let dtMuestras;
        let now = Date.now();
        window.onload = async () => {
            initTabla();

            
            UI.$("#txtFiltroRuc").addEventListener("keypress", (e) => { if (e.key === 'Enter') dtMuestras.ajax.reload(); });
            UI.$("#txtFiltroNroPF").addEventListener("keypress", (e) => { if (e.key === 'Enter') dtMuestras.ajax.reload(); });
        };

        function initTabla() {
            const formatFecha = (str) => {
                if (!str) return '<span class="text-muted">---</span>';
                const d = new Date(str);
                return d.toLocaleDateString('es-PE', { day: '2-digit', month: '2-digit', year: 'numeric' });
            };

            dtMuestras = $('#tblMuestras').DataTable({
                serverSide: true,
                info: false,
                paginType: "simple",
                processing: true,
                searchDelay: 1500,
                ajax: async (d, cb) => {
                    const $wrapper = $('#tblMuestras_wrapper');
                    $wrapper.css('opacity', '0.5').css('pointer-events', 'none');

                    try {
                        const extraParams = {
                            StatusLIMS: "",
                            ClienteRuc: UI.$("#txtFiltroRuc").value,
                            NroPF: UI.$("#txtFiltroNroPF").value
                        };

                        const res = await EstadoMuestrasPreFTService.Listar(d, extraParams, { cancelPrevious: true });
                        cb(res);
                    }
                    catch (err) {
                        console.log(err);
                        if (err.name === 'AbortError') return;
                    }
                    finally {
                        $wrapper.css('opacity', '1').css('pointer-events', 'auto');
                    }
                },
                select: {
                    style: 'multi',
                    selector: 'td:first-child'
                },
                autoWidth: false,
                scrollX: true,
                scrollY: "360px",
                columns: [
                    {
                        title: "", data: null, defaultContent: "", orderable: false,
                        className: 'select-checkbox text-center', width: "30px",
                        render: () => `<input type="checkbox" class="form-check-input chk-muestra" style="pointer-events: none !important;">`
                    },
                    {
                        title: "#",
                        render: (data, type, row, meta) => `<span class="text-muted">${meta.row + meta.settings._iDisplayStart + 1}</span>`,
                        width: "30px", className: "text-center"
                    },
                    {
                        title: "Cliente",
                        render: (data, type, row) => {
                            const ruc = row.Cliente.split("-")[0] || '---';
                            const nombre = row.Cliente.split("-")[1] || 'SIN RAZÓN SOCIAL';
                            return `
                                <div class="d-flex flex-column">
                                    <small class="fw-bold text-secondary">${ruc}</small>
                                    <span class="text-truncate" style="max-width: 200px;">${nombre}</span>
                                </div>`;
                        }
                    },
                    { data: "Customer", title: "Customer", className: "text-center" },
                    { data: "Project", title: "OT", render: (data) => data || '---' },
                    { data: "NroPF", title: "Nro. PF", render: (data) => data || '---' },
                    { data: "FechaEmision", title: "F. EMI PF", render: formatFecha },
                    { data: null, title: "F. Para Envío SAP", render: () => formatFecha(now) },
                    {
                        data: "SubTotalLineaPF", title: "Precio Unit.",
                        render: (data, type, row) => data ? `${Utils.getNumFormattedByCurName(data, row.Moneda)}` : "---"
                    },
                    {
                        data: "ValorUnitarioAnaPF", title: "Valor Unit.",
                        render: (data, type, row) => data ? `${Utils.getNumFormattedByCurName(data, row.Moneda)} ` : '---'
                    },
                    { data: "Cantidad", title: "Cant.", className: "text-center" },
                    {
                        data: "DetalleLinea", title: "Detalle",
                        render: (data) => renderColumnaDetalle(data)
                    },
                    {
                        title: "FT SAP", className: "text-center",
                        render: (data, type, row) => row.DocNumSAP
                            ? `<span class="badge bg-success">${row.SeriesSAP || ''}-${row.DocNumSAP}</span>`
                            : `<span class="badge bg-light text-muted border">PENDIENTE</span>`
                    },
                    {
                        title: "FT Firme", className: "text-center",
                        render: (data, type, row) => {
                            if (row.DocNumSAP) {
                                return row.IsDraftSAP ? `<span class="badge bg-info">No</span>` : `<span class="badge bg-success">Si</span>`;
                            }
                            return "";
                        }
                    },
                ],
                columnDefs: [
                    { targets: "_all", defaultContent: "---" }
                ],
                language: {
                    searchPlaceholder: "Buscar por OT, Cliente o Detalle..."
                }
            });

            $('#tblMuestras tbody').on('click', 'tr', function (e) {
                if ($(e.target).closest('button, a').length > 0) return;
                if ($(e.target).closest('td').index() === 0 || $(e.target).closest('.dt-control').length > 0) return;

                const chk = $(this).find('.chk-muestra');
                chk.prop('checked', !chk.prop('checked'));
                $(this).toggleClass('selected-row', chk.prop('checked'));
                actualizarEstadoBotonProcesar();
            });
        }

        function actualizarEstadoBotonProcesar() {
            const seleccionados = obtenerSeleccionados();
            const btn = UI.$("#btnProcesarSap");
            const countSpan = UI.$("#selectedCount");

            if (seleccionados.length > 0) {
                btn.classList.remove("d-none");
                countSpan.innerText = seleccionados.length;
            } else {
                btn.classList.add("d-none");
            }
        }

        function obtenerSeleccionados() {
            const identificadores = [];
            const rows = dtMuestras.rows().nodes();

            $(rows).each(function (idx, node) {
                if ($(node).find('.chk-muestra').is(':checked')) {
                    const row = dtMuestras.row(node).data();
                    identificadores.push(row);
                }
            });
            return identificadores;
        }

        async function prepararEnvioSap() {
            const idsSeleccionados = obtenerSeleccionados();

            
            
                                                
            const confirm = await Swal.fire({
                title: '¿Procesar a SAP?',
                text: `Se creará una Factura para ${idsSeleccionados.length} líneas seleccionadas.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí, enviar',
                cancelButtonText: 'Cancelar'
            });

            if (confirm.isConfirmed) {
                const payload = {
                    Identificadores: idsSeleccionados
                };

                Swal.fire({
                    title: 'Procesando...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                UI.$("#btnProcesarSap").disabled = true;
                const res = await EstadoMuestrasPreFTService.ProcesarMuestrasASap(payload);
                UI.$("#btnProcesarSap").disabled = false;

                if (res.Exito) {
                    Swal.fire("Éxito", `Factura creada. SAP DocNum: ${res.Datos.Series}-${res.Datos.DocNum}`, "success");
                    dtMuestras.ajax.reload(null, false);
                }
            }
        }

       
        function renderColumnaDetalle(data) {
            if (!data) return '---';
            const limite = 50;

            const escapeHtml = (str) => str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

            if (data.length > limite) {
                const textoTruncado = escapeHtml(data.substring(0, limite)) + "...";
                
                const textoSeguroUrl = encodeURIComponent(data).replace(/'/g, "%27");

                
                return `
                    <div class="d-flex flex-column">
                        <small class="text-wrap text-muted" style="min-width: 120px; line-height: 1.2;">
                            ${textoTruncado}
                        </small>
                        <button type="button" class="btn-ver-mas-modern" onclick="abrirFlotante('${textoSeguroUrl}', event)">
                            <i class="bi bi-eye"></i> Ver detalle
                        </button>
                    </div>`;
            }
            
            return `<small class="text-wrap" style="min-width: 120px; display:block;">${escapeHtml(data)}</small>`;
        }
        

        window.abrirFlotante = function (textoCodificado, event) {
            if (event) event.stopPropagation();             
                        const textoOriginal = decodeURIComponent(textoCodificado);

                        UI.$("#myCustomContent").innerText = textoOriginal;
            UI.$("#myCustomModal").style.display = "flex";
        };

        window.cerrarFlotante = function () {
            UI.$("#myCustomModal").style.display = "none";
        };

                window.onclick = function (event) {
            const modal = UI.$("#myCustomModal");
            if (event.target == modal) {
                cerrarFlotante();
            }
        };
    </script>
}